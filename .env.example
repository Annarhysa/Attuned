# Database (Postgres). For local dev, `docker compose up -d` and use this
# connection string as-is. For production, point at Supabase/Neon/Railway/RDS.
DATABASE_URL="postgresql://attuned:attuned@localhost:5432/attuned"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# AI provider: "local" (default, no key needed, fully offline heuristic engine),
# "openai", or "anthropic". Only set a key if you switch away from "local".
AI_PROVIDER="local"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# File storage driver: "local" (default -- disk under STORAGE_DIR, needs a host
# with a persistent filesystem) or "s3" (required on serverless hosts like
# Vercel/Netlify; works with AWS S3, Supabase Storage, Cloudflare R2, etc).
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Only used when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Stripe billing. Get a test-mode secret key from your Stripe dashboard, then
# run `npm run stripe:setup` to create the Attuned Membership product/prices
# and print the STRIPE_PRICE_* values below. For local dev, forward webhooks
# with the Stripe CLI: `stripe listen --forward-to localhost:3000/api/billing/webhook`
# and paste the printed whsec_... value into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_PRICE_YEARLY_REFERRAL=""
